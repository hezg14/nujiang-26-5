# Postgres connection (optional). If unset, the API falls back to in-memory storage for local dev.
DATABASE_URL=postgresql://user:password@localhost:5432/nujiang
# Allowed browser origins (comma separated)
CORS_ORIGINS=http://localhost:3000

# ---- Lead notifications (optional) ----
# Where a submitted enquiry should land. Leave blank and nothing is emailed;
# the lead is still stored in the database.
LEAD_NOTIFY_EMAIL=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to 0 only for a relay that does not support STARTTLS (port 25 relays).
SMTP_TLS=1
