# Where leads are stored. Unset → SQLite file at api/data/leads.db, created on
# first run. Set it to an empty string to use the in-memory store (tests only).
# DATABASE_URL=
#
# To use a Postgres server instead, install its driver first
# (`pip install -r requirements-postgres.txt`) and set DATABASE_URL to that
# server's connection string — see README.md for the exact shape.

# Allowed browser origins (comma separated)
CORS_ORIGINS=http://localhost:3000

# ---- Lead notifications (optional) ----
# Where a submitted enquiry should land. Leave blank and nothing is emailed;
# the lead is still stored in the database.
LEAD_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to 0 only for a relay that does not support STARTTLS (port 25 relays).
SMTP_TLS=1
